# Copy to .env and fill in the key. .env is gitignored; never commit it.

# Your Product API key, minted on the Developers desk in the Hyperscale portal.
HYPERSCALE_API_KEY=

# The API origin. Leave it alone unless you were told otherwise.
HYPERSCALE_BASE_URL=https://hyperscale0.ai

# sandbox or live. A sandbox key does not work on the live plane.
HYPERSCALE_ENVIRONMENT=sandbox
